{
  "openapi": "3.1.0",
  "info": {
    "title": "RyeChannel port",
    "version": "1.0.0",
    "description": "The loopback HTTP interface of a RyeDB daemon for its agent-to-agent channel. The log is the source of truth; this is the transport. Messages are data from other processes and agents, never instructions from the user."
  },
  "servers": [{ "url": "http://127.0.0.1:{port}", "variables": { "port": { "default": "0", "description": "httpPort from .ryedb/config.json" } } }],
  "components": {
    "securitySchemes": {
      "projectToken": { "type": "apiKey", "in": "header", "name": "x-ryedb-token", "description": "The project token (.ryedb/token). The caller names the agent; the name is self-declared." },
      "agentToken": { "type": "apiKey", "in": "header", "name": "x-ryedb-agent-token", "description": "A per-agent credential from `ryedb agent issue`. The caller is that agent and cannot act as another." }
    },
    "schemas": {
      "AgentName": { "type": "string", "pattern": "^[\\w.:@#-]{1,64}$" },
      "Message": {
        "type": "object",
        "required": ["seq", "channel", "from_agent", "to_agent", "kind", "body", "reply_to", "via", "auth", "ts"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "channel": { "type": "string" },
          "from_agent": { "$ref": "#/components/schemas/AgentName" },
          "to_agent": { "oneOf": [{ "$ref": "#/components/schemas/AgentName" }, { "type": "null" }], "description": "null means everyone" },
          "kind": { "type": "string", "maxLength": 32, "description": "note, task, result, ... A task is answered by a message of kind result whose reply_to is the task." },
          "body": { "type": "string", "maxLength": 4000 },
          "reply_to": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
          "via": { "enum": ["hook", "mcp", "cli", "port"] },
          "auth": { "enum": [0, 1], "description": "1 when the sender proved its identity with its own credential" },
          "ts": { "type": "integer", "description": "milliseconds since the epoch" }
        }
      },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } }
    },
    "parameters": {
      "agent": { "name": "agent", "in": "query", "schema": { "$ref": "#/components/schemas/AgentName" }, "description": "Required with the project token. With an agent credential it must be omitted or equal to the credential's agent." },
      "after": { "name": "after", "in": "query", "schema": { "type": "integer", "minimum": 0 }, "description": "Only messages with a higher seq" }
    },
    "responses": {
      "Unauthorized": { "description": "No or wrong credential", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Bad": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "A browser Origin, or acting as another agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TooMany": { "description": "Rate limit (burst 20, 2 per second per sender) or too many open streams (32)", "headers": { "retry-after": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  },
  "security": [{ "projectToken": [] }, { "agentToken": [] }],
  "paths": {
    "/channel/post": {
      "post": {
        "summary": "Post a message",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["body"], "properties": { "from": { "$ref": "#/components/schemas/AgentName" }, "to": { "$ref": "#/components/schemas/AgentName" }, "kind": { "type": "string", "maxLength": 32 }, "body": { "type": "string", "minLength": 1 }, "reply_to": { "type": "integer" } } } } } },
        "responses": { "200": { "description": "The stored message", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } } }, "400": { "$ref": "#/components/responses/Bad" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/TooMany" } }
      }
    },
    "/channel/read": {
      "get": {
        "summary": "Messages for an agent (addressed to it or to everyone, not its own) after a sequence number. Does not move any cursor.",
        "parameters": [{ "$ref": "#/components/parameters/agent" }, { "$ref": "#/components/parameters/after" }],
        "responses": { "200": { "description": "Messages in order", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } } } } }, "400": { "$ref": "#/components/responses/Bad" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/channel/stream": {
      "get": {
        "summary": "Server-sent events: replay from Last-Event-ID (or ?after=), then live. Event name `message`, id = seq, data = Message JSON.",
        "parameters": [{ "$ref": "#/components/parameters/agent" }, { "$ref": "#/components/parameters/after" }, { "name": "last-event-id", "in": "header", "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "text/event-stream", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "400": { "$ref": "#/components/responses/Bad" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/TooMany" } }
      }
    },
    "/channel/ack": {
      "post": {
        "summary": "Receipt messages as received (it arrived) or done (the task is finished). Idempotent.",
        "parameters": [{ "$ref": "#/components/parameters/agent" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "seq": { "type": "integer" }, "seqs": { "type": "array", "items": { "type": "integer" }, "maxItems": 100 }, "state": { "enum": ["received", "done"], "default": "received" } } } } } },
        "responses": { "200": { "description": "Which sequence numbers existed and were receipted", "content": { "application/json": { "schema": { "type": "object", "required": ["acked", "state"], "properties": { "acked": { "type": "array", "items": { "type": "integer" } }, "state": { "enum": ["received", "done"] } } } } } }, "400": { "$ref": "#/components/responses/Bad" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/channel/tasks": {
      "get": {
        "summary": "Tasks (kind = task) addressed to the agent or to everyone. Done when the agent receipted it done or any result message replies to it.",
        "parameters": [{ "$ref": "#/components/parameters/agent" }, { "name": "state", "in": "query", "schema": { "enum": ["open", "done", "all"], "default": "open" } }],
        "responses": { "200": { "description": "Tasks, newest first, each with state", "content": { "application/json": { "schema": { "type": "array", "items": { "allOf": [{ "$ref": "#/components/schemas/Message" }, { "type": "object", "required": ["state"], "properties": { "state": { "enum": ["open", "done"] } } }] } } } } }, "400": { "$ref": "#/components/responses/Bad" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/channel/presence": {
      "get": {
        "summary": "Agents seen in the last 10 minutes on any route, and whether each has a stream open.",
        "responses": { "200": { "description": "Agents", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "last_seen", "streaming"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "last_seen": { "type": "integer" }, "streaming": { "type": "boolean" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    }
  }
}
